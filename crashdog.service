[Unit]
Description=CrashDog crash-forensics snapshot daemon
Documentation=file:///usr/local/lib/crashdog/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/crashdog run
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target